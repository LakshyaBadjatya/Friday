<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- A phone without a camera can still hold the vault and read notes, so
         this is wanted, not required. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="FRIDAY"
        android:theme="@style/Theme.Friday">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".capture.CameraActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <activity
            android:name=".voice.VoiceActivity"
            android:exported="false" />

        <activity
            android:name=".capture.ScanActivity"
            android:exported="false" />

        <!-- Translucent and no-history: sharing to FRIDAY should feel like the
             thing left the other app, not like it opened a new one. -->
        <activity
            android:name=".capture.ShareReceiverActivity"
            android:exported="true"
            android:noHistory="true"
            android:theme="@style/Theme.Friday.Translucent">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".capture.ScreenCaptureActivity"
            android:exported="false"
            android:noHistory="true"
            android:theme="@style/Theme.Friday.Translucent" />

        <service
            android:name=".capture.ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <activity
            android:name=".ui.SetupActivity"
            android:exported="false" />

        <!-- The bubble draws over other apps; MIUI wants the overlay grant,
             which SetupActivity walks the user to. -->
        <!-- Holds the microphone to score "Hey FRIDAY" locally; nothing is
             sent anywhere unless it fires. -->
        <service
            android:name=".wake.WakeService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".bubble.BubbleService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="A floating capture button over other apps" />
        </service>

        <receiver
            android:name=".widget.FridayWidget"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_friday_info" />
        </receiver>

        <service
            android:name=".tile.FridayTileService"
            android:exported="true"
            android:icon="@android:drawable/ic_menu_camera"
            android:label="FRIDAY"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- The assistant slot. Selecting FRIDAY in Settings -> Apps ->
             Default apps -> Digital assistant app routes the assist gesture
             here, which is also what grants her the on-screen text without a
             screenshot or an accessibility service. -->
        <service
            android:name=".assistant.FridayInteractionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION">
            <meta-data
                android:name="android.voice_interaction"
                android:resource="@xml/interaction_service" />
            <intent-filter>
                <action android:name="android.service.voice.VoiceInteractionService" />
            </intent-filter>
        </service>

        <service
            android:name=".assistant.FridaySessionService"
            android:exported="true"
            android:permission="android.permission.BIND_VOICE_INTERACTION" />

        <!-- Not on FRIDAY's path — the session does its own recording. The
             platform refuses to parse an assistant whose metadata names no
             recogniser, and drops it from the Settings list without a word,
             so this has to exist for her to be selectable at all. -->
        <service
            android:name=".assistant.FridayRecognitionService"
            android:exported="true"
            android:label="FRIDAY"
            android:permission="android.permission.BIND_RECOGNITION_SERVICE">
            <intent-filter>
                <action android:name="android.speech.RecognitionService" />
            </intent-filter>
        </service>

    </application>

</manifest>
